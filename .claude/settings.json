{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/danger_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
